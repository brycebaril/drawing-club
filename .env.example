# Copy to .env for local development. Real secrets in staging/prod come from
# AWS Secrets Manager instead (see docs/SecurityDocument.md §4) — this file
# only matters locally.

# --- Org identity (src/lib/org.ts) ---
# Deployment-level branding, not a system_settings row — set once per
# instance, same category as the other config below. A fork running this
# for a different drawing group changes just these two lines.
ORG_LEGAL_NAME=The Vancouver Life Drawing Society
ORG_DBA_NAME=Basic Inquiry

# --- Environment/build status banner (src/lib/envStatus.ts) ---
# Deployment-level, same category as ORG_LEGAL_NAME above — set once per
# Amplify branch once provisioned. Leave APP_ENV unset locally; it falls
# back to NODE_ENV. GIT_SHA is derived automatically from the checked-out
# commit at build/start time (next.config.ts) if left unset here.
APP_ENV=development
GIT_SHA=

# --- Database (docker compose up) ---
DATABASE_URL=postgres://drawing_club:drawing_club@localhost:5432/drawing_club

# --- Auth.js ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Stripe (test mode keys — see docs/ArchitectureDocument.md §5) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` when forwarding webhooks locally
STRIPE_WEBHOOK_SECRET=

# --- AWS SES (transactional email) ---
# Leave both blank to keep using the console-logged dev email fallback
# (src/lib/email/sender.ts) — no AWS setup required for normal local dev.
# Set both only to exercise a real send locally, e.g. against your own
# SES-sandbox-verified address.
AWS_REGION=
SES_FROM_EMAIL=
# Optional — only needed for a real local send. Not required in
# staging/prod, where the Amplify compute role's IAM credentials are used
# instead (docs/SecurityDocument.md §4).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AWS S3 (CMS image uploads) ---
S3_BUCKET_NAME=

# --- Background/scheduled job authentication ---
# Shared secret checked on internal job endpoints (docs/ArchitectureDocument.md §8),
# invoked by EventBridge Scheduler in staging/prod. Any local value works for dev.
JOB_TRIGGER_SECRET=

# --- Legacy data migration (docs/MigrationPlan.md) ---
# Points at a throwaway MySQL import of the legacy Robostrar dump — never a
# production legacy system. Only used by scripts/migrate-legacy-data.ts.
LEGACY_MYSQL_URL=mysql://root:throwaway_local_only@localhost:3307/legacy_robostrar
