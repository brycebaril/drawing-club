# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test artifacts
/playwright-report/
/test-results/
/blob-report/

# local-disk upload fallback (src/lib/uploads/storage.ts) — dev/CI only,
# production always uploads to S3 instead
/public/uploads/

# legacy Robostrar DB backups for the eventual MigrationPlan.md cutover —
# large, likely contains real member data, never belongs in git history
/legacy_data/
